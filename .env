# ==========================================
# Facebook Auto Post Environment Variables
# ==========================================

# 1. Page Access Token (ต้องเป็น Token แบบไม่มีวันหมดอายุที่ได้จาก Facebook App)
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

# 2. Page ID ของเพจที่คุณต้องการโพสต์
FB_PAGE_ID=your_page_id_here
